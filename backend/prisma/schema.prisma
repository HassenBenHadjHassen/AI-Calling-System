generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Lead {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  address             String?
  postalCode          String?
  city                String?
  phone1              String
  phone2              String?
  status              LeadStatus           @default(NEW)
  campaignId          String?              @db.ObjectId
  blacklisted         Boolean              @default(false)
  scheduledCallAt     DateTime?
  scheduledCallNote   String?
  scheduledCallStatus ScheduledCallStatus?
  retryCount          Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  callHistory         CallHistory[]        @relation("LeadCallHistory")
  campaign            Campaign?            @relation(fields: [campaignId], references: [id])

  @@index([phone1])
  @@index([phone2])
  @@index([status])
  @@index([campaignId])
  @@index([blacklisted])
  @@index([scheduledCallAt])
}

model Campaign {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  name      String         @unique
  status    CampaignStatus @default(STOPPED)
  startedAt DateTime?
  stoppedAt DateTime?
  createdAt DateTime       @default(now())
  leads     Lead[]
}

model CallHistory {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  leadId      String     @db.ObjectId
  campaignId  String?
  callStatus  CallStatus
  transferred Boolean    @default(false)
  transferTo  String?
  duration    Int?
  callTime    DateTime   @default(now())
  vapiCallId  String?
  notes       String?
  lead        Lead       @relation(fields: [leadId], references: [id], name: "LeadCallHistory")
}

enum LeadStatus {
  NEW
  CALLED
  INTERESTED
  TRANSFERRED
  FAILED
  BLACKLISTED
  SCHEDULED
}

enum CampaignStatus {
  ACTIVE
  STOPPED
  COMPLETED
}

enum CallStatus {
  INITIATED
  COMPLETED
  TRANSFERRED
  FAILED
  SCHEDULED
}

enum ScheduledCallStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  RESCHEDULED
}
