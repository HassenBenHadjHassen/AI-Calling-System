					"description": "Optional annotation",
					"type": "string"
				},
				"scheduledCallAt": {
					"description": "New time in ISO8601 UTC",
					"type": "string"
				},
				"customerPhoneNumber": {
					"description": "This is the customer phone number starting with country code",
					"type": "string"
				}
			},
