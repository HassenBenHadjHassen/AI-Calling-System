# ==============================================================================
# AI CALLING SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Node Environment & Custom Port (Configurable - Any port e.g. 4050, 5050, 8080)
NODE_ENV=development
PORT=4050
APP_URL=http://localhost:4050

# PostgreSQL Connection String (Prisma 7 driver adapter)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_calling_system

# Safe Mode / Dry Run:
# When set to true, no real SMS are dispatched via Twilio and no real events are created in Google Calendar.
# Stored records and jobs are still persisted in PostgreSQL.
DRY_RUN=true

# ==============================================================================
# VAPI VOICE ASSISTANT INTEGRATION
# ==============================================================================
VAPI_API_KEY=your_vapi_api_key_here
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here

# Assistant UUIDs
CABINET_ASSISTANT_ID=00000000-0000-0000-0000-000000000001
BATIMENT_ASSISTANT_ID=00000000-0000-0000-0000-000000000002

# ==============================================================================
# TWILIO SMS & PHONE NUMBER INTELLIGENCE
# ==============================================================================
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+33900000001

# Tenant Outbound & Inbound Routing Phone Numbers
CABINET_INBOUND_PHONE=+33900000001
BATIMENT_OUTBOUND_PHONE=+33900000002

# Internal Alert Recipients (Mobile numbers receiving staff notifications)
NURSE_ALERT_PHONE_NUMBER=+33600000001
BATIMENT_ALERT_PHONE_NUMBER=+33600000002

# ==============================================================================
# OPENAI (Ambiguous Inbound SMS Classification)
# ==============================================================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# BETTER AUTHENTICATION
# ==============================================================================
# Generate a random 32+ char secret in production: openssl rand -base64 32
BETTER_AUTH_SECRET=your_super_secret_better_auth_key_change_in_production
BETTER_AUTH_URL=http://localhost:4050

# ==============================================================================
# OPERATIONAL DASHBOARD SECURITY (Legacy fallback)
# ==============================================================================
DASHBOARD_PASSWORD=admin123
